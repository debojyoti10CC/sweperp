# Optional. Leave blank to launch a local MongoDB automatically.
MONGODB_URI=
# Optional database name. The default preserves local preview accounts.
# MONGODB_DB=paper_trading
PORT=4173
# The server is loopback-only. Set APP_ORIGIN only if using a different local URL.
# APP_ORIGIN=http://localhost:4173
# Optional overrides for npm run sepolia. The launcher can generate a test operator locally.
# PERPLAB_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# PERPLAB_SEPOLIA_OPERATOR_KEY=
